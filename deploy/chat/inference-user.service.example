[Unit]
Description=MemoryDraft DFlash cost-tree ASD chat inference
After=network-online.target

[Service]
Type=simple
WorkingDirectory=YOUR_A6000_CHAT_ROOT/current
EnvironmentFile=YOUR_A6000_CHAT_ROOT/private/inference.env
Environment=OMP_NUM_THREADS=4
Environment=HF_HUB_OFFLINE=1
Environment=PYTHONPATH=.
ExecStart=YOUR_A6000_PYTHON -m memorydraft serve --config YOUR_A6000_CHAT_ROOT/private/runtime.json --host YOUR_A6000_TAILSCALE_IP --port 8010 --queue-capacity 2
Restart=on-failure
RestartSec=10
UMask=0077
TimeoutStopSec=150

[Install]
WantedBy=default.target
