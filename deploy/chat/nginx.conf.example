# Optional public HTTPS entry, after domain/certificate/hosting requirements are ready.
# Replace example.com and certificate paths before enabling this configuration.
server {
    listen 443 ssl;
    server_name chat.example.com;
    ssl_certificate /etc/ssl/memorydraft/fullchain.pem;
    ssl_certificate_key /etc/ssl/memorydraft/privkey.pem;
    client_max_body_size 96k;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 650s;
    }
}
